# go from left to right greedily taking the highest digit for the tens place

# with open("sample-input", 'r') as file:
with open("actual-input", 'r') as file:
    lines = file.readlines()

def calculate_largest_joltage(input):
    digits = [0] * 12
    range_start, range_end = 0, 3
    for digit_idx in range(len(digits)):
        curr_digit_val = 0
        new_start_range = -1
        for possible_nums in range(range_start, range_end):
            curr_possible_num = digits[possible_nums]
            if curr_digit_val < curr_possible_num:
                curr_digit_val = curr_possible_num
                new_start_range = possible_nums
        digits[digit_idx] = curr_digit_val
        range_start, range_end = new_start_range, new_start_range + (range_end - range_start)
        range_end = min(range_end, len(digits))
    print("Value of digits")
    print(digits)
    return -1



total_jolt = 0
for line in lines:
    largest_jolt = calculate_largest_joltage(line.strip())
    total_jolt += largest_jolt

print(f"total jolt is {total_jolt}")
